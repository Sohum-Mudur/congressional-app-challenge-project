# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (used in email links). Vercel: your production URL.
SITE_URL=http://localhost:3000

# SAFETY SWITCH. While true, every digest goes to TEST_INBOX instead of a real agency.
# Only set to false after the agency has agreed to receive reports.
TEST_MODE=true
TEST_INBOX=you@example.com

# Receives digests for agencies that only take web forms (NJDOT, Somerset County), so a person can submit them.
ADMIN_EMAIL=you@example.com

# Resend (https://resend.com). Without a key, emails are saved to .data/outbox and shown at /dev/outbox.
RESEND_API_KEY=
EMAIL_FROM="Signal Report <onboarding@resend.dev>"

# Secret mixed into the scrambled network codes used for anti-spam. Any long random string; never change it once live.
NETWORK_SALT=

# Protects /api/digest in production. Vercel Cron sends it automatically. Any long random string.
CRON_SECRET=

# Supabase (Project Settings → API Keys). The publishable key is safe to expose; the secret key is not.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Postgres connection string (Connect → Direct → Session pooler), used to run migrations.
DATABASE_URL=
